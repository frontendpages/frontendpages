{
  "name": "@repo/storage",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#env": "./env.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*"
  },
  "scripts": {
    "clean": "rimraf node_modules .turbo",
    "env:codegen": "varlock codegen",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1149.0",
    "@aws-sdk/s3-presigned-post": "3.1149.0",
    "@aws-sdk/s3-request-presigner": "3.1149.0",
    "files-sdk": "3.1.0",
    "varlock": "catalog:"
  },
  "devDependencies": {
    "@repo/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
